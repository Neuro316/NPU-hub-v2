# .env.example: every environment variable the Hub reads, by name, with what it is for.
# Values are never committed. scripts/guards/run-guards.cjs fails the build when code
# reads a variable that is not listed here.

# ── Supabase (shared project htfrfaxlcuyawtlztxxm) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URLs ──
# Public origin of the Hub, no trailing slash. Builds Twilio callbacks, unsubscribe
# links and /a/<token> asset links.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
# Set by Vercel itself; listed so the guard knows it is expected.
VERCEL_URL=

# ── Crons and internal callers ──
# Bearer secret Vercel attaches to cron calls. The new crons refuse every request when it is unset.
CRON_SECRET=
# Bearer secret for POST /api/notify/sms. Unset refuses every request.
HUB_NOTIFY_SECRET=

# ── AI ──
ANTHROPIC_API_KEY=

# ── Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_VOICE_SIGNATURE_MODE=
NOTIFICATION_PHONE=

# ── Transcription, Google, integrations ──
DEEPGRAM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPS_SCRIPT_URL=
NEUROREPORT_URL=
READAI_WEBHOOK_SECRET=
NP_ORG_ID=
NP_PIPELINE_ID=

# ── Marketing engine (added 2026-09-30, docs/plans/hub-marketing-build-rulings.md) ──
# Resend API key. ALREADY SET in Vercel (Production and Preview); reused, never read
# or printed by tooling. Read at send time, so rotating it needs no code change.
RESEND_API_KEY=
# Signing secret of the Resend webhook endpoint (starts with whsec_). Unset means
# /api/webhooks/resend refuses every request.
RESEND_WEBHOOK_SECRET=
# At least 32 random characters. Signs one-click unsubscribe tokens. Unset means no
# marketing email can be sent live and no unsubscribe link verifies. Rotating it
# invalidates links already sent, so rotate only on compromise.
HUB_UNSUBSCRIBE_SECRET=
# Comma-separated origins allowed to POST to /api/intake from a browser, for example
# https://neuroprogeny.com,https://www.neuroprogeny.com. The Hub's own origin is always allowed.
HUB_INTAKE_ALLOWED_ORIGINS=
# Optional. Profile id the job watchdog texts through hub_sms_outbox. Defaults to the owner.
HUB_WATCHDOG_USER_ID=
