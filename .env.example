# .env.example: every environment variable the Hub reads, by name, with what it is for.
# Values are never committed. scripts/guards/run-guards.cjs fails the build when code
# reads a variable that is not listed here.

# ── Supabase (shared project htfrfaxlcuyawtlztxxm) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URLs ──
# Public origin of the Hub, no trailing slash. Builds Twilio callbacks, unsubscribe
# links and /a/<token> asset links.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
# Set by Vercel itself; listed so the guard knows it is expected.
VERCEL_URL=

# ── Crons and internal callers ──
# Bearer secret Vercel attaches to cron calls. The new crons refuse every request when it is unset.
CRON_SECRET=
# Bearer secret for POST /api/notify/sms. Unset refuses every request.
HUB_NOTIFY_SECRET=
# POST /api/agent/mail-search (Running List q26). The Bearer secret the scheduled Morning Call Prep task sends
# (at least 32 characters; openssl rand -hex 32), and the ONE user it acts as (that user's auth id, a uuid). Unset
# or short: every Bearer request is refused 401; a superadmin session still works.
MAIL_SEARCH_AGENT_SECRET=
MAIL_SEARCH_AGENT_USER_ID=
# Key for the one-way hash of search terms in hub_mail_search_log (at least 32 characters; openssl rand -hex 32).
# Unset: mail search refuses every request (503), since it never runs without its log.
MAIL_SEARCH_LOG_KEY=

# ── AI ──
ANTHROPIC_API_KEY=
# Campaign Builder model (docs/plans/hub-agent-build-rulings.md ruling 11). Unset means
# claude-sonnet-5-5. A model with no price in src/lib/agent/pricing.ts refuses to run.
AGENT_MODEL=
# Hub Guide model (ruling 21). Unset means claude-haiku-4-5-20251001.
AGENT_HELP_MODEL=
# Local click-through only: 1 swaps both assistants for a scripted model (src/lib/agent/stub-model.ts).
# Ignored whenever NODE_ENV is production, so it can never apply to a deployed build.
AGENT_STUB_MODEL=

# ── Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_VOICE_SIGNATURE_MODE=
NOTIFICATION_PHONE=

# ── Transcription, Google, integrations ──
DEEPGRAM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPS_SCRIPT_URL=
NEUROREPORT_URL=
READAI_WEBHOOK_SECRET=
NP_ORG_ID=
NP_PIPELINE_ID=

# ── Marketing engine (added 2026-09-30, docs/plans/hub-marketing-build-rulings.md) ──
# Resend API key. ALREADY SET in Vercel (Production and Preview); reused, never read
# or printed by tooling. Read at send time, so rotating it needs no code change.
RESEND_API_KEY=
# Signing secret of the Resend webhook endpoint (starts with whsec_). Unset means
# /api/webhooks/resend refuses every request.
RESEND_WEBHOOK_SECRET=
# At least 32 random characters. Signs one-click unsubscribe tokens. Unset means no
# marketing email can be sent live and no unsubscribe link verifies. Rotating it
# invalidates links already sent, so rotate only on compromise.
HUB_UNSUBSCRIBE_SECRET=
# Comma-separated origins allowed to POST to /api/intake from a browser, for example
# https://neuroprogeny.com,https://www.neuroprogeny.com. The Hub's own origin is always allowed.
HUB_INTAKE_ALLOWED_ORIGINS=
# At least 32 random characters. Lets another of our systems (the University platform)
# call POST /api/intake server to server, idempotent on event_id. See docs/INTEGRATION_CONTRACT.md.
# Unset means server mode refuses every request; public form submissions are unaffected.
HUB_INTAKE_SERVER_SECRET=
# Optional. Profile id the job watchdog texts through hub_sms_outbox. Defaults to the owner.
HUB_WATCHDOG_USER_ID=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Lead Device Kit (docs/INTEGRATION_CONTRACT.md). Server only, never logged.
LEAD_INTAKE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hub Health (q23, /api/cron/hub-health). Server only, never logged.
# A fine-grained GitHub token, read only on Neuro316/NPU-hub-v2 (Actions, Deployments, Pull requests, Checks,
# Metadata). Without it the CI, production deploy and open PR tiles show unknown.
HUB_HEALTH_GITHUB_TOKEN=
# Optional: the Hub profile texted when a tile turns red (the owner by default).
HUB_HEALTH_ALERT_USER_ID=
